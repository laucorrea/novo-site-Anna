:root {
--cor-primaria: #2465AB;
--cor-secundaria: #0fafe0;
    --cor-fundo: #ffffff;
    --cor-texto: #2465AB;
    --cor-contraste: #f3eef7;
    --cor-botao: #eadada;
    --cor-border: #1c94b9;

    --fonte-texto:  Arial, sans-serif
}

* {
    transition: background-color 0.8s ease;
}

.tema-escuro  {
    --cor-primaria: #3e5d7d;
--cor-secundaria: #07a0cf;
    --cor-fundo: #252323;
    --cor-texto: #d9dbdd;
    --cor-contraste: #eaf2fb;
    --cor-botao: #f9f9f9;
    --cor-border:  #1c94b9; 



}

.tema-escuro a {
    color: var(--cor-texto)
}

.tema-escuro p{
    color: var(--cor-texto)
}

.tema-escuro header p {
    color: var(--cor-contraste)
}

.tema-escuro .btn-tema-escuro {
    background-color: var(--cor-secundaria)
}
body {
    max-width: 100vw; 
    font-family:var(--fonte-texto);
}

header {
    background-color:var(--cor-primaria);
    color:var(--cor-contraste);
    text-align: center;
    margin: 0 auto;
    padding: 16px;
    border: 5px solid var(--cor-border);


}




main {
    background-color: var(--cor-fundo);
    color:var(--cor-primaria);
    text-align: left;
    margin: 0 auto;
    padding: 16px;

    display: flex ;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    
}

.post {
    
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 2px 2px 18px rgba(0, 84, 253, 0.3);
    margin: 15px; 
    padding: 15px;

    flex: 1 1 30%;
}
    


img {
    width: 80px;
    height: 80px;
}

.artigo-autor {
    font-weight: bold;
}

.btn-tema-escuro {
    position: fixed;
    bottom: 16px;
    right: 16px;
    font-size: 32px;
    padding: 12px;
    background-color: var(--cor-primaria);
    border-radius: 50%;
}
